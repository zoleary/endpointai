# Copy to .env and fill in. Never commit .env.
# Leave CLIENT_ID / CLIENT_SECRET empty to run with mock data.
CLIENT_ID=
CLIENT_SECRET=
ZSAI_ID_HOST=https://id.zsai.sqrx.io
ZSAI_API_HOST=https://use2.api.zsai.sqrx.io
# auto = live if credentials are set, otherwise mock. Set to "mock" to force demo data.
ZSAI_MODE=auto
