# Zscaler Endpoint AI Security (zsai) demo settings.
# Copy to .env (run.sh does this for you). Never commit .env.

# API key from Console > Administration > API Access.
# Leave both blank to run in MOCK mode (offline sample data).
CLIENT_ID=
# Starts with sqrx_sk_ . Never paste it into chat, a URL, or a log.
CLIENT_SECRET=

# Identity host (token minting). Usually unchanged.
ID=https://id.zsai.sqrx.io
# Regional API host. US: use2. Asia Pacific: apse1. Confirm on the API Access page.
API=https://use2.api.zsai.sqrx.io

# mock | live. Blank = live when CLIENT_ID and CLIENT_SECRET are set, else mock.
DEMO_MODE=

# HTTP timeout in seconds for API calls.
ZSAI_TIMEOUT=20
